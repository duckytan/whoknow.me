[
  {
    "id": "poor",
    "name": "穷鬼套餐",
    "weight": 5,
    "trigger": {
      "condition": "orderTotal < 20",
      "probability": 1.0,
      "cooldownMin": 0,
      "maxPerUser": 0
    },
    "rarity": "common",
    "achievements": ["poor_meal"],
    "chain": [
      { "phase": "accept", "actor": "boss", "text": "¥{orderTotal}也好意思点？锅都懒得开", "moodDelta": -30 },
      { "phase": "cook", "actor": "boss", "text": "老板在躺椅上玩手机，厨房没动静", "delay": 15000 },
      { "phase": "deliver", "actor": "rider", "text": "等了好久才出餐，这单亏了" },
      { "phase": "complete", "actor": "boss", "text": "下次低于这个数，我建议你还是好好吃饭", "effect": { "tags": ["boss_complained"] } }
    ]
  },

  {
    "id": "cheap_no_rider",
    "name": "便宜菜多 · 骑手拒单",
    "weight": 3,
    "trigger": {
      "condition": "avgDishPrice < 10",
      "probability": 1.0,
      "cooldownMin": 0,
      "maxPerUser": 0
    },
    "rarity": "uncommon",
    "achievements": ["cheap_ghost"],
    "chain": [
      { "phase": "accept", "actor": "boss", "text": "都是便宜货，做起来没劲" },
      { "phase": "deliver", "actor": "system", "text": "系统广播：该订单无人接单" },
      { "phase": "deliver", "actor": "system", "text": "系统强行指派——骑手：¥{deliveryFee}的配送费？" },
      { "phase": "complete", "actor": "rider", "text": "骑手全程冷漠脸，台词都懒得多说一句" }
    ]
  },

  {
    "id": "bankrupt_love",
    "name": "破产 · 被接济 · 结成眷侣",
    "weight": 1,
    "trigger": {
      "condition": "orderTotal >= 300",
      "probability": 0.3,
      "cooldownMin": 0,
      "maxPerUser": 0
    },
    "rarity": "epic",
    "achievements": ["bankrupt_legend"],
    "chain": [
      {
        "phase": "complete",
        "actor": "system",
        "text": "系统：这顿饭把你吃破产了，余额瞬间归零",
        "next": ["bk_bro", "bk_crush", "bk_wed"],
        "nextWeights": [6, 3, 1]
      },
      { "phase": "complete", "actor": "rider", "id": "bk_bro", "text": "看你可怜，这单我垫了，下次别这么狠", "effect": { "flags": ["bro_{riderId}"] } },
      { "phase": "complete", "actor": "rider", "id": "bk_crush", "text": "要不…这顿我请？咱俩也算认识了", "effect": { "flags": ["crush_{riderId}"] } },
      { "phase": "complete", "actor": "boss", "id": "bk_wed", "text": "婚礼上那单外卖被摆了 C 位——你们就这么成了", "effect": { "flags": ["married_{riderId}"] } }
    ]
  },

  {
    "id": "overeat_cares",
    "name": "暴饮暴食 · 老板心疼",
    "weight": 3,
    "trigger": {
      "condition": "todayOrderCount >= 3",
      "probability": 0.2,
      "probabilityScaling": { "param": "todayOrderCount", "threshold": 3, "rate": 0.2 },
      "cooldownMin": 0,
      "maxPerUser": 0
