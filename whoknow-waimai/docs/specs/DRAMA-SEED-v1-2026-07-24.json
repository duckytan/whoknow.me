      { "phase": "complete", "actor": "boss", "id": "oe_ok", "text": "还好，年轻，扛得住——不过少油少盐啊" },
      { "phase": "complete", "actor": "boss", "id": "oe_care", "text": "你这样不行，我给你加了个溏心蛋，补补", "effect": { "flags": ["boss_cares_{shopId}"] } }
    ]
  },

