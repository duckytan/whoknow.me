# ── 依赖 ──
node_modules/
.pnpm-store/
.yarn/

# ── 构建产物 ──
dist/
build/
*.tsbuildinfo
# 例外：胡闹外卖的预构建产物收进单一项目文件夹 whoknow-waimai/dist/，需提交以支持 Vercel 静态部署（/waimai → whoknow-waimai/dist）
!whoknow-waimai/dist/

# ── 环境变量 ──
.env
.env.local
.env.*.local

# ── 系统文件 ──
.DS_Store
Thumbs.db
*.swp
*.swo

# ── IDE ──
.vscode/
.idea/
*.sublime-*

# ── 临时文件 ──
*.log
.tmp/
temp/

# ── 旧项目引用源码（不推） ──
opensource-refs/
research-raw/

# ── agent 本地记忆（非项目文件，不推） ──
.workbuddy/

# ── mart 预构建产物（胡闹导购原型，需提交支持 Vercel 静态部署） ──
!whoknow-mart/dist/

# ── workbench 预构建产物（开发工作台，需提交支持 Vercel 静态部署，/workbench → whoknow-workbench/dist） ──
!whoknow-workbench/dist/
# 运行时数据单一来源 = public/data（vercel.json /workbench/data 路由直指）；dist/data 为构建复制产物，不重复入库
whoknow-workbench/dist/data/

# ── QA 临时验证产物（boundary/qa-validate/reverify-rider 等，非源码） ──
whoknow-waimai/.qa-tmp/
