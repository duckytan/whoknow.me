{
  "name": "whoknow-brain",
  "private": true,
  "version": "0.1.0",
  "description": "胡闹大脑 · 中枢内容工厂（Phase 3 M0–M2 骨架）",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:watch": "node --test --watch --experimental-strip-types \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "demo:store": "node --experimental-strip-types src/demo/formula-store-demo.ts",
    "demo:pipeline": "node --experimental-strip-types src/demo/pipeline-demo.ts",
    "assemble": "node --experimental-strip-types src/cli/run.ts assemble",
    "seed": "node --experimental-strip-types scripts/seed-brain-data.ts",
    "config:init": "node --experimental-strip-types src/cli/run.ts config init",
    "config:show": "node --experimental-strip-types src/cli/run.ts config show",
    "seed:config": "node --experimental-strip-types scripts/seed-platform-config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
